# L4 mini pilot — Muon step size is set by lr_muon (NS normalizes the update),
# so schedule + lr_muon are the ONLY real stability knobs. grad_clip barely
# touches Muon. Keep warmup + cosine ON.
# effective_batch = (4096/1024) * GRAD_ACCUM_STEPS = 4 * 4 = 16 sequences

BATCH_TOKENS=4096
GRAD_ACCUM_STEPS=4
STEPS=3000
VAL_EVERY=250
LOG_EVERY=50

# Warmup ramps step size from ~0; cosine shrinks it late so it can settle.
LR_SCHEDULE=cosine
LR_WARMUP_STEPS=200
MIN_LR_SCALE=0.0
LR_ADAM=1e-4
LR_MUON=0.001

WEIGHT_DECAY_ADAM=0.01
WEIGHT_DECAY_MUON=0.0
MUON_NS_STEPS=5
GRAD_CLIP=1.0

# Judge by best_val; allow some wobble before stopping.
EARLY_STOP_PATIENCE_EVALS=0
EARLY_STOP_MIN_DELTA=0.0
MAX_VAL_INCREASE_FROM_BEST=1.0
