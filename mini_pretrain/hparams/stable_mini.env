# L4 mini pilot — tuned after grad-accum divergence runs.
# effective_batch = (4096/1024) * GRAD_ACCUM_STEPS = 4 * 4 = 16 sequences

BATCH_TOKENS=4096
GRAD_ACCUM_STEPS=4
STEPS=3000
VAL_EVERY=250
LOG_EVERY=50

# No warmup/cosine until stable; old 0.005 muon LR worked at batch=4
LR_SCHEDULE=constant
LR_WARMUP_STEPS=0
LR_ADAM=1e-4
LR_MUON=0.003

WEIGHT_DECAY_ADAM=0.01
WEIGHT_DECAY_MUON=0.0
MUON_NS_STEPS=5
GRAD_CLIP=0.5

# Let run continue; judge by best_val not early-stop tail
EARLY_STOP_PATIENCE_EVALS=0
EARLY_STOP_MIN_DELTA=0.0
MAX_VAL_INCREASE_FROM_BEST=0
