# Stable profile for L4 mini_pretrain runs.
# Designed for 96M model on single L4 (24GB).
# CLI --run-mode still selects adamw / muon_global / muon_bank.

BATCH_TOKENS=4096
GRAD_ACCUM_STEPS=8
STEPS=3000
VAL_EVERY=250
LR_ADAM=1e-4
LR_MUON=0.002
WEIGHT_DECAY_ADAM=0.01
WEIGHT_DECAY_MUON=0.0
MUON_NS_STEPS=5
LR_SCHEDULE=cosine
LR_WARMUP_STEPS=100
MIN_LR_SCALE=0.01
EARLY_STOP_PATIENCE_EVALS=6
EARLY_STOP_MIN_DELTA=0.02
MAX_VAL_INCREASE_FROM_BEST=1.5
