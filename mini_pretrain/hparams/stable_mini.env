# L4 mini pilot — back to what empirically worked.
# No grad accum. Old runs at LR_MUON=0.005 got val~6.92 at step 500.
# Just need comparable runs to measure global vs bank delta.

BATCH_TOKENS=4096
GRAD_ACCUM_STEPS=1
STEPS=1500
VAL_EVERY=250
LOG_EVERY=50

LR_SCHEDULE=constant
LR_WARMUP_STEPS=0
MIN_LR_SCALE=0.1
LR_ADAM=1e-4
LR_MUON=0.005

WEIGHT_DECAY_ADAM=0.01
WEIGHT_DECAY_MUON=0.0
MUON_NS_STEPS=5
GRAD_CLIP=1.0

# No early stop — let runs finish so we can compare best_val.
EARLY_STOP_PATIENCE_EVALS=0
EARLY_STOP_MIN_DELTA=0.0
MAX_VAL_INCREASE_FROM_BEST=0
