# Stable default profile for L4 mini_pretrain runs.
# CLI --run-mode still selects adamw / muon_global / muon_bank.

BATCH_TOKENS=4096
STEPS=3000
VAL_EVERY=500
LR_ADAM=1e-4
LR_MUON=0.002
WEIGHT_DECAY_ADAM=0.01
WEIGHT_DECAY_MUON=0.001
MUON_NS_STEPS=3
LR_SCHEDULE=cosine
LR_WARMUP_STEPS=200
MIN_LR_SCALE=0.05
EARLY_STOP_PATIENCE_EVALS=4
EARLY_STOP_MIN_DELTA=0.01
MAX_VAL_INCREASE_FROM_BEST=0.8
